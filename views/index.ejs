<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= judul %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Instrument+Serif&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page">

    <%- include('partials/navbar') %>

    <header class="hero">
      <h1>Start your day<br>with flora coffee</h1>
      <p>Biji kopi segar diseduh setiap hari untuk rasa yang halus dan kaya. Teman pagi yang sibuk dan jeda singkat yang menyenangkan.</p>
    </header>

    <section class="strip">
      <div class="strip-item">
        <img src="/img/<%= sorotan[0].gambar %>" alt="<%= sorotan[0].nama %>">
      </div>
      <div class="strip-item strip-quote">
        <p>Setiap cangkir dibuat untuk membangunkanmu, menghangatkanmu, dan menemani harimu.</p>
      </div>
      <div class="strip-item">
        <img src="/img/<%= sorotan[1].gambar %>" alt="<%= sorotan[1].nama %>">
      </div>
      <div class="strip-item">
        <img src="/img/<%= sorotan[2].gambar %>" alt="<%= sorotan[2].nama %>">
      </div>
    </section>

    <section class="menu" id="menu">
      <h2>Menu Kami</h2>

      <div class="filter">
        <a href="/#menu" class="chip <%= kategoriAktif === 'semua' ? 'aktif' : '' %>">Semua</a>
        <% daftarKategori.forEach(function (k) { %>
          <a href="/?kategori=<%= k.kunci %>#menu"
             class="chip <%= kategoriAktif === k.kunci ? 'aktif' : '' %>"><%= k.label %></a>
        <% }) %>
      </div>

      <% if (daftarMenu.length === 0) { %>
        <p class="kosong">Belum ada menu untuk kategori ini.</p>
      <% } else { %>
        <div class="grid">
          <% daftarMenu.forEach(function (item) { %>
            <a href="/menu/<%= item.id %>" class="kartu">
              <img src="/img/<%= item.gambar %>" alt="<%= item.nama %>">
              <div class="kartu-isi">
                <span class="label"><%= item.kategori %></span>
                <h3><%= item.nama %></h3>
                <p class="harga">Rp <%= item.harga.toLocaleString('id-ID') %></p>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </section>

    <%- include('partials/footer') %>

  </div>
</body>
</html>